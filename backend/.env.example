PORT=3000
NODE_ENV=development

# Set this to point at a hosted database (Neon). When present it wins over the
# DB_* vars below and turns on TLS. Leave it empty for the local Docker Postgres.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=invest_platform

JWT_SECRET=change-me-in-production

# See .env for what these do.
DB_SYNCHRONIZE=true
WEB_ORIGINS=
