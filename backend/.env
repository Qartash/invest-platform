PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=invest_platform

JWT_SECRET=change-me-in-production

# Second lock on POST /admin/wipe, the one call that empties the whole platform.
# Deliberately blank here: with no value the endpoint refuses outright, so a clone
# of this repo can never wipe anything. Set the real one per environment — in the
# Render dashboard for the deployed API, in .env.local for a local database.
ADMIN_WIPE_PASSWORD=

# Google OAuth client IDs, same values as the mobile .env.
# Every id listed here is accepted as an id_token audience, so add one line per
# platform you actually ship. With all three empty, /auth/google refuses outright.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Lets TypeORM rewrite the schema to match the entities at boot. On for a local
# database you can afford to lose, and never anywhere else: it drops columns it
# does not recognise. Migrations own the schema on the deployed API.
DB_SYNCHRONIZE=true

# Origins allowed to call this API from a browser, comma-separated. Unset means
# any origin is answered, which is what the deployed web build relies on today.
WEB_ORIGINS=
