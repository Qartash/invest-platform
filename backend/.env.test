# Pins the e2e suite to the throwaway local Postgres from docker-compose.yml.
#
# The suite boots the real AppModule, which reads .env.local first — and that
# file points at the hosted database the deployed API serves from. These values
# are loaded into process.env before Nest starts, which is what keeps the hosted
# URL from being picked up; test/local-database.ts refuses to run if anything
# gets through anyway. No secrets belong in here: everything is local and
# disposable, which is why this file is committed while .env.local is not.

NODE_ENV=test

# Empty on purpose, and load-bearing rather than decorative: AppModule prefers
# DATABASE_URL over the discrete vars whenever it holds a value, so this being
# present-but-empty is what stops .env.local's hosted URL from filling it in.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Its own database, not invest_platform: the suite synchronizes the schema and
# writes rows, so sharing the development database would rewrite it.
DB_NAME=invest_platform_e2e

JWT_SECRET=e2e-only-not-a-secret
